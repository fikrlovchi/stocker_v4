# MoySklad API tokeni (panel "O'zgaruvchilar" sahifasidan boshqariladi).
# Bekor qilingan buyurtmalar ro'yxati va (keyingi fazalarda) tovar barcode'lari
# hamda "Собран" holatini o'rnatish uchun kerak.
MOYSKLAD_TOKEN=

# Google Sheets — uzbuyo@gmail.com OAuth2 kalitlari.
# uzumPDFs loyihasidan nusxalanadi:  cp ../../uzumpdfs/oauth.json ./oauth.json
OAUTH_FILE=

# Diagnostika endpointlari (/debug/*) uchun kalit. Bo'sh qoldirilsa
# diagnostika butunlay o'chiriladi.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SERVICE_TOKEN=

# Tinglash manzili. nginx orqasida turgani uchun faqat localhost.
# Serverdagi band portlar: 3000 fikrlovchi-panel, 4040 uzumPDFs,
# 4041 receiveMCPost, 4042 mcCancelServer, 4043 moneyReport dashboard.
HOST=127.0.0.1
PORT=4044

# SQLite fayl yo'li (bo'sh bo'lsa: <loyiha>/data/stocker.db)
DB_FILE=

# fikrlovchi-panel. Bir xil serverda ishlagani uchun to'g'ridan-to'g'ri ilova
# portiga yuboriladi (nginx/TLS orqali emas) — aks holda certbot'ning
# HTTP->HTTPS redirect'i "Host: 127.0.0.1" so'rovini 404 bilan qaytaradi.
PANEL_INGEST_URL=http://127.0.0.1:3000/api/ingest/runs
PANEL_PROJECT_SLUG=stocker
PANEL_API_KEY=
