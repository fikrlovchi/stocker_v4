# Dashboard paroli (/login). O'rnatilmasa "changeme" ishlatiladi va
# konsolga ogohlantirish chiqadi.
DASHBOARD_PASSWORD=

# Generatsiya qilingan PDF'lar ochiladigan manzil (/files/... uchun prefiks).
# nginx + TLS sozlangach: https://uzum.fikrlovchi.uz
PUBLIC_BASE_URL=

# /internal/* endpointlari uchun kalit (stocker yig'ish tizimi ishlatadi).
# /root/stocker/server/.env dagi SERVICE_TOKEN bilan BIR XIL bo'lishi SHART,
# aks holda ShK/BIG chop etish 401 bilan tushadi.
SERVICE_TOKEN=

# Uzum label keshi — uzumOrderToMC bilan UMUMIY papka bo'lishi kerak,
# shunda import paytida olingan labellar bu yerda ham topiladi.
LABEL_CACHE_DIR=

# Tinglash manzili. nginx orqasiga o'tgach 127.0.0.1 qiling.
HOST=0.0.0.0
